{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReadBrief",
  "version": "0.9.6",
  "identifier": "com.readbrief.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "ReadBrief",
        "width": 960,
        "height": 640,
        "minWidth": 720,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "settings",
        "title": "ReadBrief 设置",
        "width": 915,
        "height": 580,
        "minWidth": 915,
        "minHeight": 580,
        "center": true,
        "resizable": true,
        "visible": false
      },
      {
        "label": "float",
        "title": "ReadBrief 总结",
        "width": 630,
        "height": 560,
        "x": -20000,
        "y": -20000,
        "minWidth": 360,
        "maxWidth": 640,
        "minHeight": 200,
        "maxHeight": 560,
        "transparent": true,
        "alwaysOnTop": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:1420 https://api.github.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "icons/tray-iconTemplate.png": "icons/tray-iconTemplate.png",
      "icons/tray-iconTemplate@2x.png": "icons/tray-iconTemplate@2x.png"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist",
      "signingIdentity": "ReadBriefSelfSign"
    }
  }
}
